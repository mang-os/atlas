# Copy to .env and replace the empty password. Never commit .env.
POSTGRES_DB=atlas
POSTGRES_USER=atlas
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
SERVER_PORT=8080
REDIS_PORT=6379
KAFKA_PORT=9092
# Compose reads this file. A host-run JVM does NOT automatically read .env.
# For the JVM, export SPRING_DATASOURCE_PASSWORD as described in README.md.

# Local-only identity; all three must be set for the local profile.
ATLAS_LOCAL_ALICE_PASSWORD=
ATLAS_LOCAL_BOB_PASSWORD=
ATLAS_LOCAL_ADMIN_PASSWORD=

# Persisted hold duration in seconds; integer 1-3600.
ATLAS_HOLD_TTL_SECONDS=300

# Automatic expiration; poll integer 100-60000 ms, candidate batch integer 1-100.
ATLAS_EXPIRATION_ENABLED=true
ATLAS_EXPIRATION_POLL_MS=1000
ATLAS_EXPIRATION_BATCH_SIZE=100

# Opt in together with Compose --profile kafka; a host JVM must export these separately.
ATLAS_KAFKA_ENABLED=false
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
ATLAS_KAFKA_PUBLISHER_ENABLED=true
ATLAS_KAFKA_CONSUMER_ENABLED=true
# Integer 100-60000 ms; per-poll bound 1-100, one transaction per event.
ATLAS_KAFKA_POLL_MS=1000
ATLAS_KAFKA_BATCH_SIZE=20

# Optional informational caching; also start Compose --profile redis.
ATLAS_REDIS_ENABLED=false
ATLAS_REDIS_HOST=localhost
ATLAS_REDIS_PORT=6379
ATLAS_REDIS_CONNECT_TIMEOUT_MS=100
ATLAS_REDIS_COMMAND_TIMEOUT_MS=100
# Integer 1-1000; defaults to maximum 1-second refill age.
ATLAS_REDIS_FILL_BUDGET_MS=1000

# Phase 12: durable publisher/consumer retries and guarded reconciliation.
ATLAS_RECOVERY_ENABLED=true
ATLAS_RECOVERY_POLL_MS=10000
ATLAS_RECOVERY_BATCH_SIZE=100
ATLAS_RECOVERY_STUCK_MS=60000
ATLAS_RECOVERY_MAX_ATTEMPTS=5
ATLAS_RECOVERY_BASE_DELAY_MS=1000
ATLAS_RECOVERY_MAX_DELAY_MS=60000
